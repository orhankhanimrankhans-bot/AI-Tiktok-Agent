# Server Environment Variables for Jarvis Web

# Port
PORT=3001

# Client URL (same domain as production, localhost for dev)
CLIENT_URL=http://localhost:5173

# Session secret - must be a strong random string
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Google OAuth
# - GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET must be set in Google Cloud Console
# - Production: use https://direngineeringsolutionscom.com URLs
# - Development: use http://localhost URLs
GOOGLE_CLIENT_ID=

# !!! DO NOT commit real secret values. Use placeholder only.
# !!! Set in Hostinger or Google Cloud Console console.
GOOGLE_CLIENT_SECRET=

# Production redirect: https://direngineeringsolutionscom.com/api/google/auth/callback
# Development redirect: http://localhost:3001/api/google/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/auth/callback

# Node environment
NODE_ENV=development